# Copia este archivo como .env y completa tus valores. Nunca subas .env a GitHub.

# Sección 4 en adelante: Foundry SDK con Microsoft Entra ID (az login)
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Opción con API key (endpoint compatible con OpenAI)
AZURE_OPENAI_V1_ENDPOINT=https://<recurso>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<tu-key>

# Sección 7: modelo de audio con AzureOpenAI
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AUDIO_DEPLOYMENT_NAME=gpt-4o-mini-audio-preview

# Sección 6: Azure Language en Foundry Tools
LANGUAGE_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/
LANGUAGE_KEY=<tu-key>

# Sección 7: Azure Speech en Foundry Tools
SPEECH_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/
SPEECH_KEY=<tu-key>

# Sección 9: Azure Content Understanding en Foundry Tools
CU_ENDPOINT=https://<recurso>.services.ai.azure.com/
# Lección 43 y caso final: factura de José (data/Factura_Luma.pdf) publicada para el curso
FACTURA_URL=https://stai901luma3eknm.blob.core.windows.net/datos-curso/Factura_Luma.pdf
# Lección 43, paso 7 (analyzer_id="prebuilt-receipt"): recibo de compra del router de José
# FACTURA_URL=https://stai901luma3eknm.blob.core.windows.net/datos-curso/recibo_luma.jpg

# Sección 5: agente
AGENT_NAME=luma-soporte-agent
AGENT_VERSION=1
